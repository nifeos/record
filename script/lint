section_script_docs() {
    echo "==> script docs"
    # lint-scope: both
    # The record half: nife's notes/scripts.md documents nife's scripts and stays there, so the
    # record's own are documented in AGENTS.md.
    missing=""
    for f in $(git ls-files script); do
        grep -qE "$f([^a-z-]|\$)" AGENTS.md || missing="$missing $f"
    done
    if [ -n "$missing" ]; then
        echo "lint: scripts with no entry in AGENTS.md:$missing" >&2
        exit 1
    fi
    for f in $(grep -oE 'script/[a-z-]+' AGENTS.md | sort -u); do
        git ls-files --error-unmatch "$f" >/dev/null 2>&1 ||
            { echo "lint: AGENTS.md names $f, which the record does not have" >&2; exit 1; }
    done
    echo "script docs: every script in AGENTS.md, every script AGENTS.md names exists"
}

