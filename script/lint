    # runs where the workflow does.
    sh helpers/trunk-health-repeat-selftest.sh
}

section_em_dashes() {
    echo "==> em-dashes"
    # lint-scope: both
    emdash="$(printf '\342\200\224')"
    hits="$(git ls-files -z | xargs -0 grep -n "$emdash" 2>/dev/null |
        grep -v -E '^[^:]*:[0-9]+:[[:space:]]*>' || true)"
    if [ -n "$hits" ]; then
        echo "lint: em-dashes found (use commas, periods, semicolons or parentheses;" >&2
        echo "      a quotation on its own '>' line may keep its source's punctuation):" >&2
        printf '%s\n' "$hits" | sed 's/^/  /' >&2
        exit 1
    fi
    echo "em-dashes: none outside quoted blockquote lines"
}

section_spelling() {
    echo "==> spelling"
    # lint-scope: both
    if ! command -v typos >/dev/null 2>&1; then
        echo "lint: typos not found; install typos-cli (the workflow pins the version it runs)." >&2
        exit 1
    fi
    typos
    echo "spelling: clean"
}

if [ -n "${LINT_SECTION:-}" ]; then
    set -e
    "section_$LINT_SECTION"
    exit 0
fi

case "${1:-}" in
    --list)
        for id in $SECTIONS; do
            printf '%s\t%s\n' "$id" "$(sed -n "/^section_$id() {/,/^}/p" "$0" |
                sed -n 's/^    echo "==> \(.*\)"$/\1/p' | head -n 1)"
        done
        exit 0 ;;
    --section)
        case " $(echo $SECTIONS) " in
            *" ${2:-} "*) run="$2" ;;
            *) echo "script/lint: no section '${2:-}'; script/lint --list names them" >&2; exit 2 ;;
        esac ;;
    "") run="$SECTIONS" ;;
    *) echo "usage: script/lint [--list | --section <id>]" >&2; exit 2 ;;
esac

if ! python3 -c 'import tomllib' >/dev/null 2>&1; then
    echo "script/lint: python3 has no tomllib; these checks need Python 3.11 or newer." >&2
    exit 1
fi

python3 helpers/nife_tree.py overlay . || exit 1
trap 'python3 helpers/nife_tree.py unoverlay .' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

failed=""
for id in $run; do
    LINT_SECTION="$id" sh "$0" || failed="$failed $id"
done

if [ -n "$failed" ]; then
    echo >&2
    echo "lint: these sections failed:$failed" >&2
    echo "  Rerun one with script/lint --section <id>." >&2
    exit 1
fi
echo
echo "lint: every section passed"
