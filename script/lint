#!/bin/sh
#
# script/lint: every gate the record holds itself to, one section at a time.
#
#     script/lint                  run every section; fail at the end if any failed
#     script/lint --list           print each section's id and name
#     script/lint --section <id>   run one section (its verdict never stands in for a full run)
#
# Each section below is a shell function `section_<id>` that opens with `echo "==> <name>"`, the
# name nife's `script/lint` gives the section it comes from, so a log reads the same in either
# repository. A section runs in a shell of its own with `set -e`, a failing one prints what it
# always printed, the next runs anyway, and the summary at the end names every section that
# failed. The verdict is the fail-fast verdict: a run passes exactly when every section passes.
#
# What runs here. The record sections of nife's lint (the ones that read only the design record)
# and the record halves of the sections that read both, each against the record's own files and
# the record rows of the baselines (`design/*-baseline.*`, `design/removed.tsv`). The code halves
# stay in nife. design/roadmap/1018-the-design-record-moves-and-is-published/step-6-inventory.tsv
# says, section by section, which is which.
#
# **nife at its pin.** The record names nife's code: a `**Recorded.**` line names `script/lint`, a
# citation names `xtask/src/host.rs`, a counted claim counts the kernel's proof harnesses. Those
# resolve in nife at the commit basalt's `main` pins, which is the rule `nifeos/<repo>:<path>`
# citations already follow (helpers/qualified_paths.py). Before the first section, lint links every
# path nife has and the record lacks into this tree (`helpers/nife_tree.py overlay`), names each
# link in the repository's `info/exclude` so git never sees it, and removes them all at the end,
# on failure and on an interrupt too. A path the record has is never shadowed. While a run is in
# progress, do not edit or copy through those links: the checkout they point at is read-only, so
# a write fails instead of changing what the next run reads. `NIFE_TREE` names a checkout of nife at
# the pinned commit instead of the cached one (CI sets it).
#
# Adding a section: write `section_<id>` with its `==>` line and a `# lint-scope:` line, add the id
# to SECTIONS in the order it runs, and document any script it calls in AGENTS.md.

set -u
cd "$(dirname "$0")/.."

SECTIONS="claim_copy replay_line conflict_markers todo_markers roadmap reviews decisions journeys
four_digits citations citations_ratchet citations_moved fatal_risks script_docs counted_claims
naming_conventions naming_rules audits_selftest audits environment_names tracked_ignored
markdown_links prose_ratchet removed_index module_block_ratchet comment_block_ratchet parent_index
house_style history line_citations outsider_pass exception_markers repeat_issue em_dashes spelling"

section_claim_copy() {
    echo "==> script/claim is nife's, byte for byte"
    # lint-scope: record
    # The record claims lanes with nife's own script/claim and the three helpers it runs, copied
    # (decided provisionally 2026-11-23 UTC, until the fleet repository the tooling ruling names
    # exists). The copy is the file at nife's pinned commit, so a change lands in nife first and
    # reaches the record when basalt's pin moves and this section asks for the copy.
    nife="$(python3 helpers/nife_tree.py path)"
    commit="$(python3 helpers/nife_tree.py commit)"
    differ=""
    for f in script/claim helpers/branch-name-check.sh helpers/smelter-token helpers/stash-block.sh; do
        if [ ! -f "$f" ] || [ -L "$f" ] || ! cmp -s "$f" "$nife/$f"; then
            differ="$differ $f"
        fi
    done
    if [ -n "$differ" ]; then
        echo "lint: these differ from nifeos/nife at $commit, the commit basalt's main pins:$differ" >&2
        echo "  Copy them from there, in a change of their own:" >&2
        for f in $differ; do
            echo "    git -C <nife checkout> show $commit:$f > $f" >&2
        done
        echo "  and keep each file's mode (script/claim and helpers/smelter-token are executable)." >&2
        echo "  A change to the claim itself goes to nife; this copy follows the pin." >&2
        exit 1
    fi
    echo "claim copy: 4 files identical to nifeos/nife@$(echo "$commit" | cut -c1-12)"
}

section_replay_line() {
    echo "==> no reproducer in this branch's commit messages (a replay line, a seed assignment)"
    # lint-scope: both
    helpers/replay-line-check-selftest.sh >/dev/null
    helpers/read-advisory-selftest.sh >/dev/null
    helpers/ask-section-check.sh --selftest >/dev/null
    if git rev-parse --verify -q origin/main >/dev/null; then
        helpers/replay-line-check.sh --range origin/main..HEAD
    else
        echo "lint: no origin/main to compare with; the commit messages were not read for a reproducer" >&2
    fi
}

section_conflict_markers() {
    echo "==> conflict markers"
    # lint-scope: both
    if hits="$(git grep -nE '^(<{7}|={7}|>{7})( |$)' -- ':!*.lock')"; then
        echo "lint: merge conflict markers left in tracked files:" >&2
        printf '%s\n' "$hits" >&2
        exit 1
    fi
    echo "conflict markers: none"
}

section_todo_markers() {
    echo "==> TODO markers cite a milestone"
    # lint-scope: both
    # The record half: the record's own scripts and helpers. Markdown is out, as in nife.
    pattern='(TODO|FIXME|XXX|HACK)[[:blank:]]*[(:]'
    cited='(TODO|FIXME|XXX|HACK)[[:blank:]]*\(milestone [0-9]+\)'
    bad="$(git grep -nE "$pattern" -- ':!*.md' ':!script/lint' | grep -vE "$cited" || true)"
    if [ -n "$bad" ]; then
        echo "lint: TODO/FIXME markers that do not name the milestone that owns them:" >&2
        printf '%s\n' "$bad" | sed 's/^/  /' >&2
        echo "Spell it TODO(milestone N): and add the block under design/roadmap/, or take the" >&2
        echo "note out of the marker form. See design/roadmap/0094-untracked-work.md." >&2
        exit 1
    fi
    dangling=""
    for n in $(git grep -hoE "$cited" -- ':!*.md' ':!script/lint' | grep -oE '[0-9]+' | sort -un); do
        ls design/roadmap/"$(printf '%04d' "$(expr "$n" + 0)")"-* >/dev/null 2>&1 ||
            dangling="$dangling $n"
    done
    if [ -n "$dangling" ]; then
        echo "lint: TODO markers cite milestones with no block under design/roadmap/:$dangling" >&2
        exit 1
    fi
    echo "TODO markers: every one names a milestone that has a block"
}

