section_environment_names() {
    echo "==> environment names in prose"
    # lint-scope: both
    # The record half: a name in the record's prose must be read or assigned in the record's own
    # files or in nife's at its pin, which is where nearly every one of them lives.
    NIFE="$(python3 helpers/nife_tree.py path)" python3 - <<'PY'
import os, re, subprocess, sys

def tracked(root):
    out = subprocess.run(['git', '-C', root, 'ls-files'], capture_output=True, text=True,
                         check=True).stdout
    return [f for f in out.split('\n') if f]

TOKEN = re.compile(r'\b((?:NIFE|CRICKER)_[A-Z0-9_]+)\b')
RETIRED = {
    'NIFE_MCAST_PORT': 'milestone 298 (retire the multicast DNS responder), 2026-09-15: the '
                       'multicast prober and its runner hub (notes/mdns.md)',
}
live = set()
for root in ('.', os.environ['NIFE']):
    for f in tracked(root):
        if f.endswith('.md') or f.startswith(('vendor/', 'patches/')):
            continue
        p = os.path.join(root, f)
        if os.path.islink(p) or not os.path.isfile(p):
            continue
        text = open(p, errors='replace').read()
        for m in re.finditer(r'\$\{?([A-Z0-9_]+)|\b([A-Z0-9_]+)\s*[:=]|"([A-Z0-9_]+)"', text):
            live.add(m.group(1) or m.group(2) or m.group(3))
bad = []
for f in tracked('.'):
    if not f.endswith('.md') or f.startswith(('design/decisions/', 'design/audit-reports/')):
        continue
    if f == 'notes/documentation-audit.md':
        continue
    for i, line in enumerate(open(f, errors='replace'), 1):
        for name in TOKEN.findall(line):
            if name not in live and name not in RETIRED:
                bad.append((f, i, name))
if bad:
    print('lint: an environment variable named in prose does not exist in the record or in nife '
          'at its pin:', file=sys.stderr)
    for f, i, name in bad:
        print(f'  {f}:{i}: {name}', file=sys.stderr)
    print('Nothing reads or assigns it, so a reader who types it gets nothing. Either it was '
          'renamed and the prose did not follow, or the code that reads it has not landed. See '
          'notes/documentation-audit.md.', file=sys.stderr)
    sys.exit(1)
ours = sorted(n for n in live if n.startswith(('NIFE_', 'CRICKER_')))
print(f'environment names: {len(ours)} live, and every one named in prose is read or assigned '
      f'({len(RETIRED)} retired on the record)')
PY
}

section_tracked_ignored() {
    echo "==> tracked files the tree ignores"
    # lint-scope: both
    ignored="$(git ls-files -ci --exclude-standard)"
    if [ -n "$ignored" ]; then
        echo "lint: these tracked files match .gitignore:" >&2
        printf '  %s\n' $ignored >&2
        echo "  Remove it from the index (git rm --cached <path>) or un-ignore it." >&2
        exit 1
    fi
    echo "tracked-but-ignored files: none"
}

section_markdown_links() {
    echo "==> markdown links and the notes index"
    # lint-scope: both
    # The record half. The documents are the ones git tracks here, never a nife page reached
    # through a link; a relative link resolves in the record, or in nife at its pin for a nife path.
    python3 - <<'PY'
import glob, os, re, subprocess, sys

md = [f for f in subprocess.run(['git', 'ls-files', '*.md'], capture_output=True, text=True,
                                check=True).stdout.split('\n') if f]
bad = []
for f in md:
    base = os.path.dirname(f)
    for m in re.finditer(r'\[[^\]]*\]\(([^)]+)\)', open(f, errors='replace').read()):
        target = m.group(1).split('#')[0].strip()
        if not target or target.startswith(('http://', 'https://', 'mailto:')):
            continue
        if not os.path.exists(os.path.normpath(os.path.join(base, target))):
            bad.append(f'{f} -> {target}')
index_pages = ['notes/README.md'] + sorted(glob.glob('notes/README/*.md'))
index = ''.join(open(p, errors='replace').read() for p in index_pages)
notes = sorted(n for n in md if n.startswith('notes/') and n.count('/') == 1)
if not md or not notes:
    sys.exit('lint: the markdown sweep selected nothing, so the link and index checks judged '
             'nothing. See milestone 401 (a gate that selects the set it judges).')
missing = [n for n in notes if os.path.basename(n) != 'README.md' and os.path.basename(n) not in index]
if bad:
    print('lint: broken relative markdown links:', file=sys.stderr)
    for b in bad:
        print(f'  {b}', file=sys.stderr)
if missing:
    print('lint: notes/ files missing from notes/README.md and its area pages in notes/README/:',
          file=sys.stderr)
    for m in missing:
        print(f'  {m}', file=sys.stderr)
    print('Add a line to the notes/README/<area>.md page that fits; notes/README.md says how.',
          file=sys.stderr)
if bad or missing:
    sys.exit(1)
print(f'markdown: {len(md)} files, every relative link resolves, every note indexed')
PY
}

